#!/usr/bin/env bash

EXECUTION_PATH="$PWD"
PISTON_PATH="$(dirname "$(realpath "$0")")"

cd "$PISTON_PATH"
PISTON_ENV=$(cat .piston_env 2> /dev/null || echo dev)

docker_compose(){
    if [ -f "docker-compose.$PISTON_ENV.yaml" ]; then
        docker-compose -f "docker-compose.$PISTON_ENV.yaml" "$@"
    else
        docker-compose "$@"
    fi
}

case $1 in
    help)
        echo "=== Piston Management ==="
        echo "Current Environment: $PISTON_ENV"
        echo
        echo "Commands:"
        echo " select <environment>           Select the environment"
        echo " docker_compose <args...>       Interact directly with the docker-compose for the selected environment"
        echo " logs                           Show docker-compose logs"
        echo
        echo " start                          Starts piston"
        echo " stop                           Stops piston"
        echo " restart                        Restarts piston"
        echo " bash                           Opens a bash shell for the piston_api container"
        echo
        echo " update                         Fetches and applies latest updates"
        echo
        echo " <args..>                       Passthrough to piston cli tool"
        echo
        echo "Development Commands:"

        if [ "$PISTON_ENV" == dev ]; then

        echo " clean-pkgs                              Clean any package build artifacts on disk"
        echo " list-pkgs                               Lists every package manifest"
        echo " build-pkg <package> <version>           Build a package that compiles from source"
        echo " lock-pkg <package>/<version> --url URL  Pin a package to a prebuilt upstream archive"
        echo " validate-pkgs [--fetch]                 Validate every package manifest"
        echo " rebuild                                 Build and restart the docker container"
        echo " lint                                    Lint the codebase using prettier"

        else

        echo " Switch to developement environment for more info"
        echo " > piston select dev"

        fi
        ;;


    select) echo "$2" > .piston_env ;;
    docker_compose) shift; docker_compose "$@";;
    logs) docker_compose logs -f ;;

    restart) docker_compose restart ;;
    start)
        docker_compose up -d
        ;;
    stop) docker_compose down ;;
    bash) docker_compose exec api /bin/bash ;;

    rebuild)
        docker_compose build && docker_compose up -d
        ;;

    update)
        git pull
        cd cli && bun install > /dev/null && cd -
        docker_compose pull
        docker_compose up -d
        ;;

    clean-pkgs) git clean -fqXd packages ;;

    list-pkgs) "$PISTON_PATH/.github/scripts/changed-packages.sh" all | column ;;

    # Only needed for a package whose manifest has a `build:` script. One that
    # declares a prebuilt archive is installed straight from upstream by the
    # engine - nothing to build.
    build-pkg) "$PISTON_PATH/.github/scripts/build-package.sh" "$2-$3" ;;

    lock-pkg) shift; (cd "$PISTON_PATH/api" && bun run tools/lock-manifest.ts "$@") ;;

    validate-pkgs) shift; (cd "$PISTON_PATH/api" && bun run tools/validate-manifests.ts "$@") ;;

    lint)
        # Use the pinned prettier from the root package.json - an unpinned
        # prettier reformats the whole repo with different defaults.
        bun install > /dev/null
        ./node_modules/.bin/prettier --ignore-unknown --write .
        ;;
    *)
        [ -d ./cli/node_modules ] || (cd cli && bun install > /dev/null)
        cd "$EXECUTION_PATH"
        bun run "${PISTON_PATH}/cli/index.ts" "$@"
        ;;
esac
